# Copiar a .env:   cp .env.example .env
# Son credenciales de DESARROLLO, no reales.

DJANGO_SECRET_KEY=tallerhub123456
DJANGO_DEBUG=1

# PostgreSQL (base de datos principal, fuente de verdad)
POSTGRES_DB=tallerhub
POSTGRES_USER=tallerhub
POSTGRES_PASSWORD=tallerhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (caché, sesiones, OTP, intentos de login)
REDIS_URL=redis://redis:6379/0

# MongoDB (eventos, fichas de revisión, dashboard)
MONGO_USER=tallerhub
MONGO_PASSWORD=tallerhub
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=tallerhub

# Neo4j (grafo modelo-avería-pieza para sugerencias)
NEO4J_USER=neo4j
NEO4J_PASSWORD=tallerhub123
NEO4J_URI=bolt://neo4j:7687
